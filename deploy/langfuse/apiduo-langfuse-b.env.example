# 替换到 B 所需的 LANGFUSE_* 变量（apiduo 侧）
#
# 用法：复制到 core-1 的 /www/docker/apiduo-langfuse-b.env，填入 B 项目的 pk/sk，
#       chmod 600，然后作为 --env-file 传给 apiduo 容器。
#
# B 的项目：org=apiduo / project=apiduo-platform
# 密钥在 core-1 的 /www/docker/langfuse/.env 里（INIT_PROJECT_PUBLIC_KEY / SECRET_KEY）。

LANGFUSE_ENABLED=true
LANGFUSE_HOST=https://langfuse.apiduo.cn
LANGFUSE_CONSOLE_URL=https://langfuse.apiduo.cn
LANGFUSE_PUBLIC_KEY=<INIT_PROJECT_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<INIT_PROJECT_SECRET_KEY>
LANGFUSE_ENVIRONMENT=jieapi-com
# 链路全量（每个请求都进 Langfuse），内容体 10%
LANGFUSE_SAMPLE_RATE=100
LANGFUSE_CONTENT_SAMPLE_RATE=10
LANGFUSE_ERROR_SAMPLE_RATE=100
LANGFUSE_BODY_MODE=headtail
LANGFUSE_REDACT=true
# 留空 = 媒体不外部化，图片以 base64 内联进 trace
LANGFUSE_MEDIA_BASE_URL=

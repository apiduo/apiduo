<clickhouse>
  <!-- Langfuse 专用调优（2026-11-14）
       背景：链路采样从 10% 流量放到 100% 后，events_full 单行均值 ~270KB，
       一次 flush 申请 1.25GiB，2GiB 的容器直接 OOM（worker 84 次/5min）。

       落地方式：clickhouse 用户使用 default profile，扩展该 profile 即可覆盖。
       生效方式：docker cp 到 /etc/clickhouse-server/users.d/ 后 SYSTEM RELOAD USERS，
                 不需要重启容器；新连接才生效，老会话保留旧值。 -->
  <profiles>
    <default>
      <!-- 单次 async insert 的数据量上限：10MB -> 2MB -->
      <async_insert_max_data_size>2097152</async_insert_max_data_size>
      <!-- 单个 insert block 行数上限：1048576 -> 65536 -->
      <max_insert_block_size>65536</max_insert_block_size>
      <!-- 排序/聚合超过 256MB 溢写磁盘，而不是把内存打满 -->
      <max_bytes_before_external_sort>268435456</max_bytes_before_external_sort>
      <max_bytes_before_external_group_by>268435456</max_bytes_before_external_group_by>
      <!-- 48 核机器上限制并行度，降低峰值 -->
      <max_threads>8</max_threads>
      <!-- 单查询硬顶 5GB，服务端上限 7.2GB，留出 merge 余量 -->
      <max_memory_usage>5368709120</max_memory_usage>
    </default>
  </profiles>
</clickhouse>

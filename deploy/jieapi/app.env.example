# ==========================================================================
# jieapi.com 主站 —— apiduo 业务配置模板（master / standby 共用）
#
# 线上真身：/www/docker/apiduo/app.env（600，不得入库）
#
# 分层原则：
#   本文件  只放「业务配置」—— 连接串、密钥、限流、缓存、转发
#   compose 放「与资源限额耦合的参数」—— NODE_* / GOMAXPROCS / GOMEMLIMIT /
#           SQL_MAX_* / REDIS_POOL_SIZE
# 这样改 cpus / mem_limit 时，运行时参数在同一屏里，不会漏改。
# ==========================================================================

TZ=Asia/Shanghai
GIN_MODE=release

# ===== 上游数据库：宝塔宿主机 MySQL / Redis =====
# MySQL 9.0.1，库 jieapi-master，max_connections=500
SQL_DSN=root:<MYSQL_PASSWORD>@tcp(host.docker.internal:3306)/jieapi-master?charset=utf8mb4&parseTime=true
REDIS_CONN_STRING=redis://:<REDIS_PASSWORD>@host.docker.internal:6379/8

# ===== 日志库：同网络的 clickhouse 容器 =====
# 复用既有 new_api_logs 库（约 2,100 万行 / 52G，ReplacingMergeTree）
LOG_SQL_DSN=clickhouse://default:<CH_PASSWORD>@clickhouse:9000/new_api_logs?async_insert=1&wait_for_async_insert=1&async_insert_busy_timeout_ms=8000
# 实际保留 180 天。注意宝塔那份 compose 的注释写的是「30 天」，与取值不符，以这里为准。
LOG_SQL_CLICKHOUSE_TTL_DAYS=180

# ===== 集群一致性密钥：master 与 standby 必须完全一致 =====
# 换 SESSION_SECRET 会让所有现有会话失效（用户需重新登录）。
SESSION_SECRET=<64_hex>

# ⚠️ CRYPTO_SECRET 当前是镜像模板默认值 ChangeMe_...，生产上「看起来该换但不能直接换」：
# 它用于加解密 channels.key，一旦变更，库里 202 个渠道的密钥全部解不开。
# 轮换需要「旧值解密 → 新值加密」的迁移脚本，单独排期，不要顺手改。
CRYPTO_SECRET=<当前值，勿随手替换>

# ===== 缓存 / 批量写 =====
# 关掉 MEMORY_CACHE 会让每次 token 校验都查库，务必保持 true
MEMORY_CACHE_ENABLED=true
# 渠道配置变更的生效延迟（秒）。改渠道后最多等这么久。
SYNC_FREQUENCY=60
# 额度批量落库：减少 MySQL 写压力，代价是进程崩溃会丢最后 5 秒的内存扣费
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5

# ===== 异步日志写入（本文件最重要的一条）=====
# 关闭时（这是 apiduo 的默认值！）每条日志都在请求路径上同步写 ClickHouse，
# 并等待 async_insert flush（DSN 里 busy_timeout=8000ms）。
# 线上实测 SLOW SQL `INSERT INTO logs` 耗时 4–7 秒，源码注释原话：
#   "a slow or busy log database directly stalls API requests"
# 开启后请求只入队（内存 channel），后台每 5 秒用 native batch 批量写一次；
# 进程崩溃时从 spool 回放，不丢行。语义是 at-least-once，
# 重复行由 ReplacingMergeTree(ORDER BY created_at, request_id) 去重。
# ⚠️ spool 目录没有实例锁，多实例必须各自独立（本编排两个节点挂不同 /data，安全）。
LOG_WRITER_ASYNC=true
# 吞吐上限 = BATCH_SIZE / INTERVAL。默认 2000/5s ≈ 400 行/秒，
# 实测每请求 1.09 行 ⇒ 只够 ~370 req/s。为高并发调到 8000/3s ≈ 2667 行/秒。
LOG_WRITER_BATCH_SIZE=8000
LOG_WRITER_INTERVAL_MS=3000
# 以下为默认值，列出仅为便于调优
# LOG_WRITER_QUEUE_SIZE=100000      # 队列满才回落同步写入；100000 行 ≈ 90 秒缓冲
# LOG_WRITER_ENQUEUE_WAIT_MS=1000   # 队列满时最多等这么久，然后回落同步写入
# LOG_WRITER_SPOOL_MAX_MB=64


# ===== 上游转发连接池（高并发关键，不要跟着 CPU 一起降）=====
# 这是 Go Transport 的 MaxIdleConns，只占 fd 不占 CPU；
# 实测 fd 用 147 / 上限 1048576，余量极大。
STREAMING_TIMEOUT=300
RELAY_MAX_IDLE_CONNS=4096
RELAY_MAX_IDLE_CONNS_PER_HOST=1024
RELAY_IDLE_CONN_TIMEOUT=90
ERROR_LOG_ENABLED=true

# ===== 限流（Redis 共享，两个节点同一套配额）=====
# 实测峰值 7 req/s，这两个值当前远未触达，留作洪水保护
GLOBAL_API_RATE_LIMIT=10240
GLOBAL_WEB_RATE_LIMIT=600
# 登录等敏感接口：默认 20 次/20 分钟会被前端重试耗尽，实测提到 60 次
CRITICAL_RATE_LIMIT=60
CRITICAL_RATE_LIMIT_DURATION=1200

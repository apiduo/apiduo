# /opt/apiduo-cn/.env.db —— 只给 MySQL / ClickHouse 两个容器用的密码
# 权限必须 600，属主 root。它同时被 docker-compose.apiduo-cn.yml 的
# ${VAR:?} 插值读取。
#
# 为什么和应用的 /www/data/apiduo-cn/.env 分开：
#   应用容器不需要 DB 的 root 密码（它走 SQL_DSN 里的业务账号/同一密码），
#   混在一份文件里会把 root 密码注入到对外暴露的容器环境中。
#
# 生成方式（换掉现有明文密码时）：
#   openssl rand -base64 32 | tr -d '/+=' | head -c 32
MYSQL_ROOT_PASSWORD=
CLICKHOUSE_PASSWORD=

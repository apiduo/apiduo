{
  "$schema": "https://design-tokens.org/draft/schema.json",
  "$description": "apiduo 错误看板的令牌契约。值取自 design/error-dashboard-impeccable.html 的 :root，已用 dembrandt 反向抽取核对（7 个颜色值、4 档字号、3 个断点一致）。修改任何值都要同步改 CSS 变量，否则两者会漂移。",
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#fcfcfa",
      "$description": "页面底色。近白但不纯白，纯白在长时间盯屏时会刺眼。"
    },
    "paper-2": {
      "$type": "color",
      "$value": "#f4f4f1",
      "$description": "次级表面：行 hover、代码底色。只比 paper 深一档，不能再深，否则会变成卡片。"
    },
    "rule": {
      "$type": "color",
      "$value": "#e4e4de",
      "$description": "分隔线。所有区块只靠这条线区分，不用边框、不用阴影。"
    },
    "rule-2": {
      "$type": "color",
      "$value": "#cfcfc7",
      "$description": "强分隔：表格底线、面板边缘、控件描边。"
    },
    "ink": {
      "$type": "color",
      "$value": "#1a1c1e",
      "contrastOnPaper": "16.9:1",
      "$description": "正文与数字。带一点蓝，和 paper 的暖白形成冷热对比。"
    },
    "ink-2": {
      "$type": "color",
      "$value": "#45484b",
      "$description": "次级正文：状态句、表格正文。"
    },
    "muted": {
      "$type": "color",
      "$value": "#6b7076",
      "contrastOnPaper": "4.9:1",
      "$description": "标签、图注、说明。全站最浅的可读文字，再浅就过不了 AA。"
    },
    "accent": {
      "$type": "color",
      "$value": "#9a3412",
      "$description": "唯一强调色（赭红）。只用于「异常」语义：峰值、故障时段、主错误码。全局出现次数应少于 20 处。"
    },
    "accent-soft": {
      "$type": "color",
      "$value": "#fdf0ea",
      "$description": "强调色的浅色版：文本选区、轻微高亮。"
    },
    "ok": {
      "$type": "color",
      "$value": "#3f6f4a",
      "$description": "成功/目标达成。只在重试阶梯和链路成功节点出现。"
    },
    "err": {
      "$type": "color",
      "$value": "#a4161a",
      "$description": "硬错误：取数失败、脚本异常。与 accent 区分——accent 是「值得注意」，err 是「坏了」。"
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" }, "$description": "最小间隔：图标与文字、标签与值" },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" }, "$description": "同组元素之间" },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$description": "表格单元格内边距" },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" }, "$description": "控件间距、面板内边距" },
    "5": { "$type": "dimension", "$value": { "value": 24, "unit": "px" }, "$description": "页面左右留白" },
    "6": { "$type": "dimension", "$value": { "value": 32, "unit": "px" }, "$description": "区块内部上下" },
    "7": { "$type": "dimension", "$value": { "value": 48, "unit": "px" }, "$description": "区块之间（第二屏的起点）" },
    "8": { "$type": "dimension", "$value": { "value": 64, "unit": "px" }, "$description": "页面底部留白" }
  },
  "fontSize": {
    "label": { "$type": "dimension", "$value": { "value": 12, "unit": "px" }, "$description": "标签、图注、表头。可读下限，不得再小。" },
    "body": { "$type": "dimension", "$value": { "value": 14, "unit": "px" }, "$description": "正文、表格内容、状态句" },
    "section": { "$type": "dimension", "$value": { "value": 18, "unit": "px" }, "$description": "区块标题、首屏主句" },
    "display": { "$type": "dimension", "$value": { "value": 24, "unit": "px" }, "$description": "保留档位，当前页面未使用" }
  },
  "lineHeight": {
    "tight": { "$type": "number", "$value": 1.15, "$description": "标题" },
    "body": { "$type": "number", "$value": 1.55, "$description": "正文" },
    "loose": { "$type": "number", "$value": 1.65, "$description": "长文段落" }
  },
  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["IBM Plex Sans", "system-ui", "-apple-system", "PingFang SC", "sans-serif"],
      "$description": "界面与正文。中文回落到苹方，字重对齐 400/500/600。"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"],
      "$description": "错误码、request_id、时间、数值。不是装饰，是为了等宽对齐。"
    }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "90ms", "$description": "行 hover、颜色过渡" },
    "press": { "$type": "duration", "$value": "160ms", "$description": "按压回弹" },
    "exit": { "$type": "duration", "$value": "180ms", "$description": "面板退场。必须快于进场。" },
    "enter": { "$type": "duration", "$value": "260ms", "$description": "面板进场、视图淡入" }
  },
  "easing": {
    "standard": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1], "$description": "进场默认曲线，收尾慢" },
    "out": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1], "$description": "面板进场" },
    "press": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1], "$description": "按压与退场" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": { "value": 0, "unit": "px" }, "$description": "全站默认方角。这是有意的：圆角是「卡片语言」，本设计不用卡片。" },
    "hair": { "$type": "dimension", "$value": { "value": 1, "unit": "px" }, "$description": "仅刻度柱顶部，避免像素阶梯" }
  },
  "border": {
    "hair": { "$type": "dimension", "$value": { "value": 1, "unit": "px" }, "$description": "唯一描边宽度。不出现 2px 以上的边框，更不出现左侧强调竖条。" }
  },
  "breakpoint": {
    "mobile": { "$type": "dimension", "$value": { "value": 560, "unit": "px" }, "$description": "表格重排为标签/值块，输入框字号提到 16px" },
    "tablet": { "$type": "dimension", "$value": { "value": 720, "unit": "px" }, "$description": "顶栏换行、首屏单列" },
    "desktop": { "$type": "dimension", "$value": { "value": 900, "unit": "px" }, "$description": "首屏双列（文字 + 刻度）" }
  }
}
